flowchart TD
  setup["pcphone.sh setup<br/>PC 与手机同时起 natprobe peer"]
  stun_q["各问一次 STUN，打印 MAPPED<br/>query"]
  stun_pub[公共 STUN 服务器]
  relay["脚本代替会合服务器<br/>把对方 MAPPED 写进 -file"]
  read_file["每 100ms 读 -file 得目标"]
  send_hi["每 interval 发 HI<br/>前 -warm 个用低 TTL"]
  nats["双方 NAT<br/>家宽 EIM+APDF / 5G CGNAT"]
  recv_hi["收到 HI → 原样回 HIACK"]
  trigger["触发检查：首个 HI 进来就立刻回发<br/>-trigger"]
  hiack["收到 HIACK = 双向打通<br/>算 RTT"]
  summary["汇总：建连耗时、来源地址"]

  setup -->|"PC() / PH()"| stun_q
  stun_q -->|"STUN Binding"| stun_pub
  setup -->|"give_pc / give_ph"| relay
  relay -->|"写文件"| read_file
  read_file --> send_hi
  send_hi -->|UDP| nats
  nats -->|"放行后"| recv_hi
  recv_hi --> trigger
  trigger -->|"HI t"| nats
  nats -->|"HIACK"| hiack
  hiack --> summary

