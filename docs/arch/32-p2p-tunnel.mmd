flowchart LR
  user["用户<br/>rsync / ssh monkey-p2p"]
  units["systemd-run --user p2p-tunnel<br/>两端各一个，Restart=always"]
  subgraph local["本机"]
    ssh_cfg["ssh 别名 monkey-p2p<br/>~/.ssh/config：Port 2223，HostKeyAlias 沿用 2222"]
    fwd["监听 127.0.0.1:2223，每个 TCP 连接开一条流<br/>forward"]:::changed
    open["连接断了才重新打洞，否则复用<br/>open → dialTunnel"]:::changed
  end
  rdv["会合服务器 8.140.18.211:7001 / 7000<br/>只交换地址"]
  conn["一条 QUIC 连接（BBR），登记在 live<br/>dialPeer / acceptPeer → adopt"]:::changed
  subgraph remote["对端 monkey（测试机）"]
    exp["常驻：断了重新会合<br/>expose → keepServing"]:::changed
    dial_to["每条流连 -to<br/>net.DialTimeout"]:::changed
    sshd["sshd 127.0.0.1:22"]
  end
  splice["双向对拷，读到 EOF 只关写端<br/>splice"]:::changed
  exitg["SIGTERM / SIGINT：先关全部连接再退出<br/>exitGracefully → closeLive"]:::changed

  user -->|"ssh"| ssh_cfg
  ssh_cfg -->|"TCP 127.0.0.1:2223"| fwd
  units -->|"启动 forward"| fwd
  units -->|"启动 expose"| exp
  fwd -->|"每个 TCP 连接"| open
  open -->|"经 dialTunnel：dialPeer"| conn
  exp -->|"每轮 acceptPeer"| conn
  open -->|"经 connect：REG 发送端"| rdv
  exp -->|"经 connect：REG 接收端"| rdv
  exp -->|"AcceptStream，每条流一个"| dial_to
  dial_to -->|TCP| sshd
  fwd -->|"OpenStreamSync 之后"| splice
  dial_to -->|"连上之后"| splice
  exitg -.->|"CONNECTION_CLOSE：对方 0.1 秒内知道并重连，不用等 30 秒空闲超时"| conn

