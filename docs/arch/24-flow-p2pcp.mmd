flowchart TD
  entry["入口 ×2：电脑 p2p-direct / 手机 App<br/>都是启动 p2pcp send / daemon"]
  rooms["每条连接一个子房间 room.i<br/>send 按 -conns（默认 2）切段；recv 读到第 0 条的头再接其余"]
  rdv["会合服务器 8.140.18.211:7001 / 7000<br/>一个进程听两个端口，房间共享"]

  subgraph addr["① 寻址：会合"]
    reg["新开 IPv4 socket（-bind auto 每轮现取网卡），有全局 IPv6 再开一个<br/>REG room.i id 候选：[v6]:port + 内网"]
    you["回执 YOU = 本方公网映射<br/>低端口 / 2 秒无回执 → 坏端口；等待中回执断了 → 失联"]
    peer["收到 PEER → 对方候选（公网映射 + 自报）<br/>随即 UNREG"]
  end
  subgraph pass["② 放行：打洞（IPv4、IPv6 同时）"]
    punch["每 20ms 向全部候选发 /PP<br/>v4 候选走 v4 socket，v6 走 v6 socket"]
    trig["收到对方 /PP → 回 /PA<br/>并立即反发一次 /PP（触发检查）"]
    chosen["发送端：第一个 /PA 定路径<br/>用包的源地址作对端（prflx），关掉另一个 socket"]
    nom["提名：发送端在选中路径上发 3 个 /PN<br/>接收端有两个 socket 时等 /PN 或首个 QUIC Initial"]
    retry["4 秒不通、坏端口或失联 → 换新端口、换下一个会合地址重来<br/>最多 6 轮，失败时分层诊断"]
  end
  subgraph data["③ 传输：QUIC 接管同一个 socket"]
    quic["发送端 dialPeer / 接收端 acceptPeer<br/>quic.Transport 接管，证书不校验；SIGTERM 时 closeLive 主动关闭"]:::changed
    late["迟到的 /PP 照样回 /PA<br/>answerPunch / ReadNonQUICPacket"]
    cc["拥塞控制 applyCC<br/>默认 bbr；可选 cubic / brutal"]
    write["接收端按偏移写同一文件，回 OK"]
  end

  entry -->|"exec / ProcessBuilder，App 的 -lan 由 Java 给"| rooms
  rooms -->|"每条调 connect"| reg
  reg -->|"UDP，房间名即密钥，明文"| rdv
  rdv -->|YOU| you
  rdv -->|PEER| peer
  you -.->|"坏端口 / 失联"| retry
  peer --> punch
  punch -->|"对方的 PP 到达"| trig
  trig -->|"我方 PP 被回应"| chosen
  chosen -->|"发送端"| nom
  punch -.->|"4 秒不通"| retry
  retry -.->|"新 socket"| reg
  nom -->|"同一个 socket"| quic
  quic --> late
  quic -->|"发送端"| cc
  cc -->|"QUIC 流：头 + 文件段"| write

