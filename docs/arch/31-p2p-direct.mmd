  user -->|"分享 / 选文件"| app_ui
  user -->|"右键 / 启动器"| pc_entry
  app_ui -->|"ProcessBuilder：send -to 好友（选的文件一次全交给它）/ invite / join / contacts；-config App 私有目录，-lan 本机 IP 含 IPv6"| app_core
  app_core -.->|"stdout：@STATE / @PROGRESS / @DONE / @PAIRED / @INVITE / @CONTACTS"| app_ui
  app_ui -->|"收完挪进公共下载"| phone_dl
  pc_entry -->|"exec p2pcp send"| pc_core
  pc_svc -->|"exec p2pcp daemon"| pc_core
  pc_core -->|"写 .part，校验 sha256 后改名"| pc_dl
  pc_core -.->|"进度 / 完成"| notify
  room_key -.->|"serve 按好友算出收件房间（配对密钥按方向派生）"| pc_svc
  room_key -.->|"build.sh 只把会合地址写进 APK，设备密钥手机自己生成"| app_ui
  room_key -.->|"p2pcp 自己读 server（serverConf）"| pc_core
  app_core -->|UDP| nat_phone
  pc_core -->|UDP| nat_pc
  nat_phone -->|"① /R2 / /P（只有房间号），UDP 7001 / 7000 轮换"| rdv
  nat_pc -->|"① /R2 / /P（只有房间号），UDP 7001 / 7000 轮换"| rdv
  nat_phone <-->|"② 打洞 /PP /PA ③ QUIC 直连：认证后分块传、断了续传（BBR，一个洞上 2 条连接）"| nat_pc
  nat_phone -.->|"两轮打不通（预测打不通时一轮）：经中继 3478；走中继时 15 秒起后台打洞，通了换直连续传"| rdv

