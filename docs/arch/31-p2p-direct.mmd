  user -->|"分享 / 选文件"| app_ui
  user -->|"右键 / 启动器"| pc_entry
  app_ui -->|"ProcessBuilder：send / daemon，-lan 本机 IP 含 IPv6"| app_core
  app_core -.->|"stdout：@STATE / @PROGRESS / @DONE"| app_ui
  app_ui -->|"收完挪进公共下载"| phone_dl
  pc_entry -->|"exec p2pcp send"| pc_core
  pc_svc -->|"exec p2pcp daemon"| pc_core
  pc_core -->|"写文件"| pc_dl
  pc_core -.->|"进度 / 完成"| notify
  room_key -.->|"p2p-direct 读取"| pc_svc
  room_key -.->|"build.sh 写进 APK assets"| app_ui
  app_core -->|UDP| nat_phone
  pc_core -->|UDP| nat_pc
  nat_phone -->|"① REG / PEER，UDP 7001 / 7000 轮换"| rdv
  nat_pc -->|"① REG / PEER，UDP 7001 / 7000 轮换"| rdv
  nat_phone <-->|"② 打洞 /PP /PA ③ QUIC 直连传文件（BBR，默认 2 条）"| nat_pc

