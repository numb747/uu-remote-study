flowchart LR
  researcher["用户 / 研究者"]
  subgraph product["已落地：P2P 直传"]
    apps["P2P 直传软件 ×2<br/>安卓 App + 电脑常驻服务（换网自动恢复）"]
    p2pcp["打洞直连核心 lab/p2pcp：断点续传 + 端口转发（换网迁移不断线）<br/>双栈打洞 + QUIC（BBR）+ 房间密钥通道绑定认证"]:::changed
    rdv["会合 + 中继 8.140.18.211<br/>uu-rendezvous：会合 7000+7001，中继 UDP 3478（打不通时兜底）"]:::changed
  end
  subgraph lab["研究实验室"]
    netns_lab["netns NAT 实验室<br/>lab.sh + nftables / conntrack 模拟 NAT；p2pcp 回归测试"]:::changed
    real_lab["真实网络编排 ×2<br/>lab/real/pcphone.sh / cc-bench.sh"]
    holepunch["打洞实验工具 ×3<br/>punch / natprobe / stunprobe"]
    transport["传输层实验 ×3<br/>transport / fakeenc / xfer"]
  end
  real_nat["真实 NAT<br/>家宽路由 / 运营商 CGNAT"]
  stun_pub[公共 STUN 服务器]

  researcher -->|"点发送 / 常驻接收"| apps
  apps -->|"启动 p2pcp send / daemon"| p2pcp
  researcher -->|"rsync / ssh 经 forward 端口"| p2pcp
  p2pcp -->|"UDP 穿过：打洞 + QUIC 直连"| real_nat
  real_nat -->|"/R2·/U2 → /P·/Y（只报房间名的 HMAC）；打不通时 /L 进中继"| rdv
  researcher -->|"运行 run / matrix / script"| netns_lab
  researcher -->|运行| real_lab
  netns_lab -->|"go build，ip netns exec"| holepunch
  netns_lab -->|"运行 xfer"| transport
  netns_lab -->|"script：p2pcp-test.sh 跑传文件、续传、迁移、中继用例"| p2pcp
  real_lab -->|"natprobe（PC + adb 手机）"| holepunch
  real_lab -->|"cc-bench：比拥塞控制 × 连接数"| p2pcp
  real_lab -->|"xfer 复用打洞端口"| transport
  holepunch -->|"UDP 穿过（真实网络）"| real_nat
  real_nat -->|"STUN Binding"| stun_pub

