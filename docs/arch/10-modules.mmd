flowchart LR
  subgraph punch_pkg["lab/punch：会合 + 打洞"]
    punch_server["会合服务器<br/>runServer"]
    punch_peer["打洞对等端<br/>runPeer"]
    host_cand["host 候选收集<br/>hostCandidates"]
    punch_sock["可切换 TTL 的 socket<br/>sock.send"]
  end
  set_ttl["设置 IP_TTL ×2<br/>setTTL"]
  subgraph natprobe_pkg["lab/natprobe：NAT 画像"]
    np_tests["画像测试 ×4<br/>runStun / runFilter / runTTL / runLife"]
    np_server["配合服务端<br/>runServer"]
    np_stun["最小 STUN 编解码<br/>query / bindingResponse"]
    np_peer["手工打洞对等端<br/>runPeer"]
  end
  stunprobe["映射行为探测<br/>stunprobe"]
  lab_sh["netns 实验室<br/>lab.sh"]
  pcphone["PC ↔ 手机编排<br/>pcphone.sh"]
  transport["传输层 ×3<br/>transport / fakeenc / xfer"]
  stun_pub[公共 STUN 服务器]

  punch_peer -->|"REG"| punch_server
  punch_server -->|"PEER"| punch_peer
  punch_peer -->|调用| host_cand
  punch_peer -->|"PUNCH / ACK / PING / KA"| punch_sock
  punch_sock -->|调用| set_ttl
  np_tests -->|"FILT / TTLA·B·C / LIFE"| np_server
  np_tests -->|query| np_stun
  np_tests -->|"runTTL 调用"| set_ttl
  np_server -->|bindingResponse| np_stun
  np_peer -->|query| np_stun
  np_peer -->|"低 TTL 预热"| set_ttl
  np_stun -->|"STUN Binding"| stun_pub
  stunprobe -->|"STUN Binding"| stun_pub
  lab_sh -->|"ip netns exec … server"| punch_server
  lab_sh -->|"ip netns exec … peer"| punch_peer
  lab_sh -->|"run_xfer"| transport
  pcphone -->|"natprobe stun"| np_tests
  pcphone -->|"natprobe peer -file"| np_peer

