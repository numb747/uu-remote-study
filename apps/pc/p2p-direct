#!/bin/bash
# P2P 直传 · 电脑端入口（install.sh 装到 ~/.local/bin/p2p-direct）
#
#   p2p-direct daemon          常驻接收（systemd 用户服务 p2p-direct.service 跑的就是它），存到 ~/Downloads/P2P直传
#   p2p-direct send [文件...]  发到手机；不带文件就弹选择框（启动器图标、Dolphin 右键都走这里）
#
# 手机要开着「P2P 直传」App 才能收。进度和结果都走桌面通知。
set -euo pipefail
BIN=~/.local/bin/p2pcp
ROOM=$(cat ~/.config/p2pcp/room)
# 会合服务器：p2pcp 自己读 ~/.config/p2pcp/server（install.sh 写的，可以是同一台服务器的几个端口，每轮换一个，
# docs/09 第 8 节）；P2P_SERVER 可覆盖
SRV=(${P2P_SERVER:+-server "$P2P_SERVER"})
# 开着 sing-box TUN 时，要绑物理网卡的地址才能打洞（否则走的是代理出口）。-bind auto 让 p2pcp 每轮现取 main 表
# 默认路由那块网卡的地址：换了网络，常驻服务不用重启

case ${1:-} in
daemon)
	mkdir -p ~/Downloads/P2P直传
	exec "$BIN" daemon "${SRV[@]}" -room "$ROOM.pc" -bind auto -o ~/Downloads/P2P直传 -notify
	;;
send)
	shift
	files=("$@")
	if [ ${#files[@]} -eq 0 ]; then
		mapfile -t files < <(zenity --file-selection --multiple --separator=$'\n' --title "发送到手机（P2P 直传）" 2>/dev/null) || exit 0
	fi
	[ ${#files[@]} -gt 0 ] || exit 0
	notify-send -a "P2P 直传" -i p2p-direct "正在连接手机" "请确认手机上「P2P 直传」App 开着" || true
	exec "$BIN" send "${SRV[@]}" -room "$ROOM.phone" -bind auto -timeout 60s -notify "${files[@]}"
	;;
*)
	sed -n '2,8p' "$0"
	exit 2
	;;
esac
